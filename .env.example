# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://audituser:auditpass@localhost:5432/auditlog?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
HASH_SECRET="replace-with-openssl-rand-hex-32"
GENESIS_HASH="audit-log-genesis"
INTERNAL_API_KEY="replace-with-openssl-rand-hex-32"

# Dashboard OAuth
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
GITHUB_CLIENT_ID="github-oauth-client-id"
GITHUB_CLIENT_SECRET="github-oauth-client-secret"

# Brevo alerts
BREVO_API_KEY=
ALERT_EMAIL_FROM="alerts@example.com"
ALERT_EMAIL_TO="you@example.com"

# Rate limiting
RATE_LIMIT_EVENTS_WINDOW_MS=60000
RATE_LIMIT_EVENTS_MAX=200
RATE_LIMIT_VERIFY_WINDOW_MS=300000
RATE_LIMIT_VERIFY_MAX=1

# Redis cache
ACTIVITY_CACHE_MAX_ENTRIES=50
ACTIVITY_CACHE_TTL_SECONDS=3600

# Dashboard API URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
API_URL="http://localhost:3000"
