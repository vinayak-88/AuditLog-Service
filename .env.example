# Copy this file to .env for a local run, or provide the same variables through your deployment platform.
PORT=3000
DATABASE_URL="postgresql://audituser:auditpass@localhost:5432/auditlog?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CORS_ORIGINS="http://localhost:3001"
HASH_SECRET="replace-with-a-long-random-secret"
GENESIS_HASH="audit-log-genesis"
INTERNAL_API_KEY="replace-with-a-long-random-key"

# Dashboard authentication and API connection
NEXTAUTH_URL="http://localhost:3001"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
GITHUB_CLIENT_ID="replace-with-github-client-id"
GITHUB_CLIENT_SECRET="replace-with-github-client-secret"
API_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:3000"
DASHBOARD_OWNER_ID="replace-with-owner-id"

# Optional alerts
BREVO_API_KEY=
ALERT_EMAIL_FROM="alerts@example.com"
ALERT_EMAIL_TO="ops@example.com"

# Operational tuning
API_KEY_CACHE_TTL_SECONDS=600
RATE_LIMIT_EVENTS_WINDOW_MS=60000
RATE_LIMIT_EVENTS_MAX=200
RATE_LIMIT_VERIFY_WINDOW_MS=300000
RATE_LIMIT_VERIFY_MAX=1
RATE_LIMIT_APPS_WINDOW_MS=60000
RATE_LIMIT_APPS_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=100
RATE_LIMIT_EXPORT_WINDOW_MS=60000
RATE_LIMIT_EXPORT_MAX=10
ACTIVITY_CACHE_MAX_ENTRIES=50
ACTIVITY_CACHE_TTL_SECONDS=3600
ANALYTICS_CACHE_TTL_SECONDS=60
ANALYTICS_VOLUME_WINDOW_DAYS=30
ANALYTICS_ACTOR_WINDOW_DAYS=7
ANALYTICS_ACTION_WINDOW_DAYS=7
VERIFY_CHAIN_BATCH_SIZE=500
VERIFY_JOB_TTL_SECONDS=3600
JSON_EXPORT_MAX_ROWS=10000
