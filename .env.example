# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL="postgresql://audituser:auditpass@localhost:5432/auditlog?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Security
HASH_SECRET="replace-with-openssl-rand-hex-32"
GENESIS_HASH="audit-log-genesis"
INTERNAL_API_KEY="replace-with-openssl-rand-hex-32"

# Dashboard OAuth
NEXTAUTH_URL="http://localhost:3001"
# Comma-separated list of allowed CORS origins. Defaults to NEXTAUTH_URL if not set.
# CORS_ORIGINS=https://dashboard.example.com,https://staging.example.com
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
GITHUB_CLIENT_ID="github-oauth-client-id"
GITHUB_CLIENT_SECRET="github-oauth-client-secret"

# Brevo alerts
BREVO_API_KEY=
ALERT_EMAIL_FROM="alerts@example.com"
ALERT_EMAIL_TO="you@example.com"

# Rate limiting
RATE_LIMIT_EVENTS_WINDOW_MS=60000
RATE_LIMIT_EVENTS_MAX=200
RATE_LIMIT_VERIFY_WINDOW_MS=300000
RATE_LIMIT_VERIFY_MAX=1
RATE_LIMIT_APPS_WINDOW_MS=60000
RATE_LIMIT_APPS_MAX=30
RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=100
RATE_LIMIT_EXPORT_WINDOW_MS=60000
RATE_LIMIT_EXPORT_MAX=10

# Redis cache
ACTIVITY_CACHE_MAX_ENTRIES=50
ACTIVITY_CACHE_TTL_SECONDS=3600

# Analytics
ANALYTICS_CACHE_TTL_SECONDS=60
ANALYTICS_VOLUME_WINDOW_DAYS=30
ANALYTICS_ACTOR_WINDOW_DAYS=7
ANALYTICS_ACTION_WINDOW_DAYS=7

# Dashboard API URLs
NEXT_PUBLIC_API_URL="http://localhost:3000"
API_URL="http://localhost:3000"
